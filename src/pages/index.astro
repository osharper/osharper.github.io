---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/home/Section.astro';
import Social from '../components/home/Social.astro';
import { areas } from '../areas';
import { excerpt, fmtDate, getLog, getPlantings, isActive } from '../lib/greenhouse';
import photo from '../assets/me.jpg';

// Rebuilt on every push here or to a vault, so build-time values stay fresh.
const now = new Date();
const yearsOfExperience = now.getFullYear() - 2009;

const [log, plantings] = await Promise.all([getLog(), getPlantings()]);
const areaStatus: Record<string, string> = {
  greenhouse: log[0]
    ? `Last logged ${fmtDate(log[0].data.date)} · ${plantings.filter(isActive).length} batches growing. ${excerpt(log[0], 'Summary', 200)}`
    : '',
};

const focus = [
  {
    title: 'Delivery pipelines',
    text:
      'CI/CD, release trains and infrastructure as code on AWS (EKS, Lambda, Terraform). I automate the boring, risky parts of a release — schema and index checks, migrations, worker rollouts — so releases stop depending on someone remembering a checklist.',
  },
  {
    title: 'Agent orchestration',
    text:
      'I built and run an internal Claude Code plugin marketplace: shared skills, agents, hooks and MCP access to observability and data. It is used by the whole product team, not just developers: QA engineers and product managers open their own pull requests and run the QA and release agents themselves.',
  },
  {
    title: 'Quality control',
    text:
      'Quality gates that run before code reaches production: automated regression suites mapped to the test plan, review agents for database and performance issues, upfront checks on index definitions and migrations. And the judgement to switch off automation that creates more noise than signal.',
  },
  {
    title: 'Team direction',
    text:
      'Setting goals for a small cross-functional team, mentoring, leading production incidents and post-mortems, and running a legacy-to-new-platform migration in stages behind kill switches, without stopping the product.',
  },
];

const tools = [
  { group: 'Platform & delivery', items: ['AWS (EKS, Lambda, S3)', 'Terraform', 'Kubernetes', 'Docker', 'Jenkins', 'GitHub Actions'] },
  { group: 'AI engineering', items: ['Claude Code', 'MCP servers', 'Agentic workflows', 'Review & release agents'] },
  { group: 'Quality & observability', items: ['Playwright', 'Jest', 'Zephyr', 'Grafana', 'Prometheus / Loki', 'PostHog'] },
  { group: 'Backend & data', items: ['TypeScript / Node.js (NestJS)', 'C# / .NET', 'Python', 'MongoDB', 'Elasticsearch', 'RabbitMQ', 'Redis'] },
  { group: 'Frontend', items: ['React', 'Next.js', 'Angular', 'Astro'] },
  { group: 'Exploring', items: ['Go', 'Rust'] },
];
---

<Base
  title="Oleg Dolotov — Tech Lead: delivery pipelines, AI agents, quality"
  description="Oleg Dolotov, tech lead for healthcare SaaS: delivery pipelines, agent orchestration and quality control that let a small team ship like a big one."
>
  <div class="flex flex-col gap-4 py-6">
    <figure class="card flex flex-col items-center gap-5 px-5 py-6 text-center sm:flex-row sm:gap-8 sm:px-8 sm:text-left">
      <Image
        src={photo}
        alt="Oleg Dolotov"
        width={256}
        height={256}
        class="size-32 shrink-0 rounded-full border-4 border-slate-300 object-cover dark:border-slate-600"
        loading="eager"
      />
      <figcaption>
        <p class="font-mono text-xs text-slate-500 dark:text-slate-400">&gt; Hello world!</p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight sm:text-4xl">Oleg Dolotov</h1>
        <p class="mt-2 text-lg text-slate-700 sm:text-xl dark:text-slate-300">
          Tech lead for healthcare SaaS. I build the pipelines, agents and quality gates that let a small team ship like
          a big one.
        </p>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
          {yearsOfExperience} years in software · digital nomad on Ko Pha-ngan, Thailand, working with US teams
        </p>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
          Father, beach volleyball player, tea drinker. Also: a tropical greenhouse, folk music, and a camera pointed
          at birds and lizards.
        </p>
      </figcaption>
    </figure>

    <div class="card flex flex-col items-center gap-4 px-5 py-4 sm:flex-row sm:justify-between">
      <Social />
      <a
        href="https://docs.google.com/document/d/1mVbuZVcYO2aDbF2FcHohd8dmozP17fEKvVGJ9ykWtaA/export?format=pdf"
        class="shrink-0 rounded bg-accent px-4 py-2 font-semibold text-white hover:bg-accent-strong dark:text-slate-950"
      >
        Download CV
      </a>
    </div>

    <Section title="What I do" id="about">
      <p>
        These days I write less code and spend more time on the system around it: how work gets from a ticket to
        production, who checks what, and which parts a machine should do. I lead a small team at
        <a class="text-accent underline-offset-2 hover:underline" href="https://showd.me/">Showd.me</a>, a training and
        compliance platform for US healthcare organisations, where I started as a full-stack engineer in 2017.
      </p>
      <ul class="grid gap-3 pt-1 sm:grid-cols-2">
        {
          focus.map((f) => (
            <li class="rounded border border-slate-200 p-4 dark:border-slate-700">
              <span class="font-semibold">{f.title}</span>
              <span class="mt-1 block text-sm">{f.text}</span>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section title="Healthcare" id="healthcare">
      <p>
        Most of my last nine years has been in US healthcare: workforce training and certification for home-care and
        clinical organisations, where every completion has to end up in the right compliance record. That means
        integrating with the HR, payroll and EVV systems agencies already run, syncing staff records every day, and
        sending completions back — reliably, because a missed sync means a caregiver who can't work. Before that I led
        development of a platform that matched patients with clinical trials.
      </p>
    </Section>

    <Section title="How I work" id="principles">
      <ul class="list-disc space-y-2 pl-5">
        <li>
          <span class="font-semibold">Automate the checklist, not the judgement.</span> Agents should catch the missing
          index or migration before a release; people should decide what ships.
        </li>
        <li>
          <span class="font-semibold">AI adoption is a team habit, not a tool rollout.</span> The goal is fewer
          hand-offs and a lower cognitive load. If agents start generating tickets nobody reads, the setup is wrong.
        </li>
        <li>
          <span class="font-semibold">Small teams, wide ownership.</span> When QA and product can safely change code
          and run releases themselves, a small team stops waiting on its developers.
        </li>
        <li>
          <span class="font-semibold">Migrate in slices.</span> New platforms go live piece by piece, behind kill
          switches and parity checks, never as a big-bang rewrite.
        </li>
      </ul>
    </Section>

    <Section title="How I think" id="thinking">
      <p>
        I'm most interested in the places where a technical problem turns out to be a behaviour problem. A release
        process, an AI rollout and a task app fail in the same way: people, and increasingly agents, respond to
        incentives, habits and friction, whatever the design document says. So I like to look at a system through more
        than one lens: biology and behaviour, sociology, computation.
      </p>
      <p>
        People whose way of thinking I keep coming back to: Robert Sapolsky on behaviour as biology and context, Michael
        Levin on cognition at every scale, Stephen Wolfram on complexity from simple rules.
      </p>
      <p>
        GTD RPG, my side project, is a small experiment in this. Modern entertainment is tuned to hook our dopamine
        circuitry, and willpower rarely wins that fight, in kids or in adults. So instead of resisting it, the system
        uses the same wiring: you earn what you already want, like an hour of YouTube, by doing things that matter.
        It's classical conditioning in the spirit of Karen Pryor's <em>Don't Shoot the Dog</em>. A bit Pavlovian, and
        honest about it.
      </p>
    </Section>

    <Section title="Tools" id="tools">
      <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-[auto_1fr]">
        {
          tools.map(({ group, items }) => (
            <>
              <dt class="font-mono text-sm leading-7 text-slate-500 dark:text-slate-400">{group}</dt>
              <dd class="flex flex-wrap gap-1.5">
                {items.map((item) => (
                  <span class="rounded border border-slate-200 px-2 py-0.5 text-sm dark:border-slate-700">{item}</span>
                ))}
              </dd>
            </>
          ))
        }
      </dl>
    </Section>

    <Section title="Outside work" id="life">
      <p>
        I live on Ko Pha-ngan, Thailand, with my family. When I'm not at a screen I'm usually on the beach volleyball
        court, drinking too much tea, or in the greenhouse — I'm slowly building a small home farm and greenhouse
        automation setup, and would love to hear from anyone doing tropical growing or garden automation.
      </p>
      <p>
        I'm building GTD RPG, a gamified task system for kids, adults, teams and maybe even AI agents. The idea: an AI
        checks that a task was really done, and the rewards are real too, coins that unlock things like extra screen
        time or a snack cabinet. It's still early and not public. If you're into gamification, behaviour change or
        agent incentives, I'd love to compare notes.
      </p>
      <p>
        There's also a Telegram bot that runs signups for my local beach volleyball group, with Google Calendar and an
        AI assistant. Same story: early, and not public yet.
      </p>
      <ul class="grid gap-3 pt-2 sm:grid-cols-2">
        {
          areas.map((area) => (
            <li>
              <a
                href={area.href}
                class="group block h-full rounded border border-slate-200 p-4 hover:border-accent dark:border-slate-700"
              >
                <span class="font-semibold text-accent group-hover:underline">{area.title} →</span>
                <span class="mt-1 block text-sm">{area.tagline}</span>
                {areaStatus[area.id] && (
                  <span class="mt-2 block text-xs text-slate-500 dark:text-slate-400">{areaStatus[area.id]}</span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section title="Contact me" id="contact">
      <p>
        Email <a class="text-accent underline-offset-2 hover:underline" href="mailto:odolotov@gmail.com">odolotov@gmail.com</a>{' '}
        or message me on <a class="text-accent underline-offset-2 hover:underline" href="https://t.me/osharper">Telegram</a>.
        If you'd rather I reach out first, leave your details in the form below.
      </p>
      <iframe
        src="https://docs.google.com/forms/d/e/1FAIpQLSc8Ebyw7xoitGWw0aOSGcp7qkUbKzwWut8b3R9YCKpXMwcjiQ/viewform?embedded=true"
        title="Contact form"
        loading="lazy"
        class="h-[780px] w-full max-w-2xl rounded border border-slate-200 bg-white dark:border-slate-700"
      >
        Loading…
      </iframe>
    </Section>
  </div>
</Base>
