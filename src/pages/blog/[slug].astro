---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Blog from '../../layouts/Blog.astro';
import { fmtPostDate, getPosts } from '../../lib/blog';

export const getStaticPaths = (async () =>
  (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }))) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, lang, draft } = post.data;
---

<Blog title={title} kicker="Blog" description={description} lang={lang} published={date}>
  <p slot="header" class="mt-2 font-mono text-xs text-slate-500 dark:text-slate-400" lang="en">
    {fmtPostDate(date)}{updated && ` · updated ${fmtPostDate(updated)}`}{draft && ' · draft'}
  </p>

  <article class="card prose-site px-5 py-5 sm:px-8" lang={lang}>
    <Content />
  </article>

  <p class="px-1 text-sm">
    <a class="text-accent underline-offset-2 hover:underline" href="/blog/">← All posts</a>
  </p>
</Blog>
