---
import Greenhouse from '../../../layouts/Greenhouse.astro';
import StatusPill from '../../../components/greenhouse/StatusPill.astro';
import { excerpt, getSeeds, imagesOf, titleOf } from '../../../lib/greenhouse';

const seeds = (await getSeeds()).map((seed) => ({
  seed,
  photo: imagesOf(seed)[0],
  rating: seed.data.rating,
  summary: excerpt(seed, 'Suitability', 180),
}));
---

<Greenhouse
  title="Seed bank"
  kicker="Greenhouse"
  description="Seeds assessed for tropical growing on Koh Phangan, each with a grow guide and a suitability rating."
>
  <p slot="header" class="mt-3 max-w-3xl leading-relaxed text-slate-700 dark:text-slate-300">
    Every packet gets researched before sowing: source, reviews, growing needs, a day-by-day grow guide, and a
    suitability rating for this climate. The rating is about fit for heat, humidity and few pollinators, not seed
    quality.
  </p>

  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      seeds.map(({ seed, photo, rating, summary }) => (
        <a href={`/greenhouse/seedbank/${seed.id}/`} class="card group flex flex-col overflow-hidden hover:border-accent">
          {photo ? (
            <img src={photo} alt="" loading="lazy" class="aspect-[4/3] w-full object-cover" />
          ) : (
            <div class="aspect-[4/3] w-full bg-accent-soft/50" />
          )}
          <div class="flex flex-1 flex-col gap-2 p-4">
            <div class="flex items-start justify-between gap-2">
              <h2 class="font-semibold leading-snug group-hover:text-accent">{titleOf(seed)}</h2>
              {rating && <span class="font-mono text-sm font-bold text-accent">{rating}</span>}
            </div>
            <StatusPill status={seed.data.status} />
            {summary && <p class="line-clamp-3 text-sm text-slate-600 dark:text-slate-300">{summary}</p>}
          </div>
        </a>
      ))
    }
  </div>
</Greenhouse>
