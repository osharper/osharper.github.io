---
import Greenhouse from '../../../layouts/Greenhouse.astro';
import PlantingCard from '../../../components/greenhouse/PlantingCard.astro';
import { getPlantings, isActive } from '../../../lib/greenhouse';

const plantings = await getPlantings();
const groups = [
  { id: 'active', title: 'Growing', items: plantings.filter(isActive) },
  { id: 'planned', title: 'Planned', items: plantings.filter((p) => p.data.status === 'planned') },
  { id: 'ended', title: 'Finished', items: plantings.filter((p) => ['done', 'failed'].includes(p.data.status)) },
];
const known = new Set(groups.flatMap((g) => g.items));
const other = plantings.filter((p) => !known.has(p));
if (other.length) groups.push({ id: 'other', title: 'Other', items: other });
---

<Greenhouse
  title="Plantings"
  kicker="Greenhouse"
  description="Every planting batch in the greenhouse: sow date, where it grows, status and expected milestones."
>
  <p slot="header" class="mt-3 max-w-3xl leading-relaxed text-slate-700 dark:text-slate-300">
    One record per batch: this variety, sown on this date, in this place. Expected germination and harvest windows
    come from the seed bank entry at sowing time. Failed batches stay here with what went wrong.
  </p>

  {
    groups
      .filter((g) => g.items.length)
      .map((group) => (
        <section id={group.id} aria-label={group.title} class="scroll-mt-20">
          <h2 class="mb-2 font-mono text-sm font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400">
            {group.title} <span class="font-normal">({group.items.length})</span>
          </h2>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((planting) => (
              <PlantingCard planting={planting} />
            ))}
          </div>
        </section>
      ))
  }
</Greenhouse>
