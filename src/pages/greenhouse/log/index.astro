---
import Greenhouse from '../../../layouts/Greenhouse.astro';
import LogCard from '../../../components/greenhouse/LogCard.astro';
import { getLog } from '../../../lib/greenhouse';

const log = await getLog();
const months = Map.groupBy(log, (entry) =>
  entry.data.date.toLocaleDateString('en-GB', { timeZone: 'UTC', month: 'long', year: 'numeric' }),
);
---

<Greenhouse
  title="Daily log"
  kicker="Greenhouse"
  description="Day-by-day greenhouse log: what was sown, thinned, fed, harvested or lost, with photos."
>
  <p slot="header" class="mt-3 max-w-3xl leading-relaxed text-slate-700 dark:text-slate-300">
    One entry per day: what happened, the plan for the day, issues, photos and where every batch stands. Newest first.
  </p>

  {
    [...months].map(([month, entries]) => (
      <section aria-label={month}>
        <h2 class="mb-2 font-mono text-sm font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400">{month}</h2>
        <div class="flex flex-col gap-3">
          {entries.map((entry) => (
            <LogCard entry={entry} />
          ))}
        </div>
      </section>
    ))
  }
</Greenhouse>
