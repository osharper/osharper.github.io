---
import type { CollectionEntry } from 'astro:content';
import { excerpt, fmtDate, imagesOf, section } from '../../lib/greenhouse';

interface Props {
  entry: CollectionEntry<'greenhouseLog'>;
  /** Max photos in the strip. */
  photos?: number;
}

const { entry, photos = 4 } = Astro.props;
const images = imagesOf(entry);
const plannedTasks = section(entry, 'Plan').match(/^- \[[ x]\]/gm)?.length ?? 0;
const summary =
  excerpt(entry, 'Summary', 420) ||
  excerpt(entry, 'Log', 420) ||
  (plannedTasks ? `Nothing logged this day, just the plan: ${plannedTasks} task${plannedTasks > 1 ? 's' : ''}.` : '');
---

<article class="card p-4 sm:p-5">
  <h3 class="font-mono text-sm">
    <a href={`/greenhouse/log/${entry.id}/`} class="font-bold text-accent hover:underline">{fmtDate(entry.data.date, 'long')}</a>
    {entry.data.weather && <span class="text-slate-500 dark:text-slate-400"> · {entry.data.weather}</span>}
  </h3>
  {summary && <p class="mt-2 text-[15px] leading-relaxed">{summary}</p>}
  {
    images.length > 0 && (
      <a href={`/greenhouse/log/${entry.id}/#photos`} class="mt-3 flex gap-2 overflow-hidden" aria-label="Photos from this day">
        {images.slice(0, photos).map((src) => (
          <img src={src} alt="" loading="lazy" class="size-20 shrink-0 rounded border border-slate-200 object-cover sm:size-24 dark:border-slate-700" />
        ))}
        {images.length > photos && (
          <span class="flex size-20 shrink-0 items-center justify-center rounded border border-dashed border-slate-300 font-mono text-xs text-slate-500 sm:size-24 dark:border-slate-600">
            +{images.length - photos}
          </span>
        )}
      </a>
    )
  }
</article>
