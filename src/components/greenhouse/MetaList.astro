---
// Key/value grid for note frontmatter. Rows with empty values are skipped.
interface Props {
  rows: [label: string, value: unknown, href?: string][];
}

const rows = Astro.props.rows.filter(([, value]) => value !== undefined && value !== null && value !== '');
---

{
  rows.length > 0 && (
    <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-sm sm:grid-cols-[auto_1fr_auto_1fr]">
      {rows.map(([label, value, href]) => (
        <>
          <dt class="font-mono text-xs leading-5 text-slate-500 dark:text-slate-400">{label}</dt>
          <dd>{href ? <a href={href} class="text-accent hover:underline">{String(value)}</a> : String(value)}</dd>
        </>
      ))}
    </dl>
  )
}
