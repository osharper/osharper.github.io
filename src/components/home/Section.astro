---
interface Props {
  title: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<section id={id} class="card scroll-mt-16 px-5 py-5 sm:px-8 sm:py-6" aria-labelledby={id && `${id}-title`}>
  <h2 id={id && `${id}-title`} class="text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
  <div class="mt-3 space-y-3 leading-relaxed text-slate-700 dark:text-slate-300">
    <slot />
  </div>
</section>
